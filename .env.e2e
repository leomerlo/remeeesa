# The end-to-end suite talks to the local emulators, which accept any
# project config: nothing here reaches a real Firebase project, and these
# are not secrets.
VITE_FIREBASE_API_KEY=emulator-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=remeeesa-e2e
VITE_FIREBASE_APP_ID=1:0:web:e2e
VITE_FIREBASE_EMULATORS=1

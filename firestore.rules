rules_version = '2';

// Live rule execution is not in CI (no Firestore emulator). Review by inspection.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/household_members/$(request.auth.uid);
    }

    function isMemberOf(householdId) {
      return isSignedIn()
        && exists(membershipPath())
        && get(membershipPath()).data.household_id == householdId;
    }

    function isValidHousehold(data) {
      return data.keys().hasOnly(['name', 'monthly_budget', 'created_at'])
        && data.name is string
        && data.name.size() > 0
        && data.name.matches('.*\\S.*')
        && data.monthly_budget is number
        && data.monthly_budget > 0
        && data.created_at is timestamp;
    }

    function isValidMembership(data) {
      return data.keys().hasOnly(['household_id', 'joined_at'])
        && data.household_id is string
        && data.household_id.size() > 0
        && data.joined_at is timestamp
        && existsAfter(/databases/$(database)/documents/households/$(data.household_id));
    }

    function isValidJoinMembership(data) {
      return data.keys().hasOnly(['household_id', 'joined_at', 'invite_token'])
        && data.household_id is string
        && data.household_id.size() > 0
        && data.joined_at is timestamp
        && data.invite_token is string
        && data.invite_token.size() > 0
        && exists(/databases/$(database)/documents/household_invites/$(data.invite_token))
        && get(/databases/$(database)/documents/household_invites/$(data.invite_token)).data.household_id == data.household_id;
    }

    function isValidInvite(data) {
      return data.keys().hasOnly(['household_id', 'created_at'])
        && data.household_id is string
        && data.household_id.size() > 0
        && data.created_at is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasOnly(['household_id', 'name', 'color', 'created_at'])
        && data.household_id is string
        && data.household_id.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.name.matches('.*\\S.*')
        && data.color is string
        && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.created_at is timestamp;
    }

    function canWriteCategoryFor(householdId) {
      return isMemberOf(householdId)
        || (
          isSignedIn()
          && !exists(/databases/$(database)/documents/households/$(householdId))
          && existsAfter(/databases/$(database)/documents/households/$(householdId))
          && existsAfter(membershipPath())
          && getAfter(membershipPath()).data.household_id == householdId
        );
    }

    // Category ids are `{householdId}_{encodedName}`. Missing-doc gets are
    // allowed only for the caller's household so find-or-create cannot probe
    // whether another household already has a name.
    function isOwnHouseholdCategoryId(categoryId) {
      return exists(membershipPath())
        && categoryId.size() > get(membershipPath()).data.household_id.size()
        && categoryId[0:get(membershipPath()).data.household_id.size()] == get(membershipPath()).data.household_id
        && categoryId[get(membershipPath()).data.household_id.size():get(membershipPath()).data.household_id.size() + 1] == '_';
    }

    function isValidExpense(data) {
      return data.keys().hasOnly(['household_id', 'category_id', 'member_id', 'name', 'price', 'comments', 'expense_date', 'created_at', 'author_display_name'])
        && data.household_id is string
        && data.household_id.size() > 0
        && data.category_id is string
        && data.category_id.size() > 0
        && data.member_id is string
        && data.member_id.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.name.matches('.*\\S.*')
        && data.price is number
        && data.price > 0
        && data.comments is string
        && data.expense_date is timestamp
        && expenseDateNotInFuture(data.expense_date)
        && data.created_at is timestamp
        && data.author_display_name is string
        && data.author_display_name.size() > 0
        && data.author_display_name.matches('.*\\S.*')
        && exists(/databases/$(database)/documents/categories/$(data.category_id))
        && get(/databases/$(database)/documents/categories/$(data.category_id)).data.household_id == data.household_id;
    }

    function authorDisplayNameUnchanged() {
      return !resource.data.keys().hasAll(['author_display_name'])
        || request.resource.data.author_display_name == resource.data.author_display_name;
    }

    function isValidExpenseUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'price', 'category_id', 'comments', 'expense_date'])
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['household_id', 'member_id', 'author_display_name', 'created_at'])
        && request.resource.data.household_id == resource.data.household_id
        && request.resource.data.member_id == resource.data.member_id
        && authorDisplayNameUnchanged()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && (request.resource.data.comments is string
          || request.resource.data.comments == null)
        && request.resource.data.expense_date is timestamp
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.category_id))
        && get(/databases/$(database)/documents/categories/$(request.resource.data.category_id)).data.household_id == resource.data.household_id;
    }

    // Local-noon expense dates can be a few hours ahead of request.time
    // (morning in the local calendar). Year/month/day on request.time are
    // methods; using them as fields makes this check fail closed.
    function expenseDateNotInFuture(expenseDate) {
      return expenseDate < request.time + duration.value(1, 'd');
    }

    // status must be 'pending' on create -- this is what blocks a client
    // from creating a Cuenta that is already marked paid. Editing, deleting,
    // and marking a cuenta paid are handled by later tickets in this feature.
    function isValidCuenta(data) {
      return data.keys().hasOnly(['household_id', 'category_id', 'name', 'due_date', 'expected_amount', 'recurring', 'status', 'paid_expense_id', 'created_at'])
        && data.household_id is string
        && data.household_id.size() > 0
        && data.category_id is string
        && data.category_id.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.name.matches('.*\\S.*')
        && data.due_date is timestamp
        && (data.expected_amount == null || (data.expected_amount is number && data.expected_amount > 0))
        && data.recurring is bool
        && data.status == 'pending'
        && data.paid_expense_id == null
        && data.created_at is timestamp
        && exists(/databases/$(database)/documents/categories/$(data.category_id))
        && get(/databases/$(database)/documents/categories/$(data.category_id)).data.household_id == data.household_id;
    }

    // Editing is only allowed while the cuenta is still pending -- once paid,
    // it is frozen at the rules level (mirrors isValidExpenseUpdate's shape,
    // adapted to the cuenta field set). A future category-merge feature may
    // need a category-only update allowed regardless of status; that is not
    // implemented here.
    function isValidCuentaUpdate() {
      return resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'category_id', 'due_date', 'expected_amount', 'recurring'])
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['household_id', 'status', 'paid_expense_id', 'created_at'])
        && request.resource.data.household_id == resource.data.household_id
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.matches('.*\\S.*')
        && request.resource.data.due_date is timestamp
        && (request.resource.data.expected_amount == null
          || (request.resource.data.expected_amount is number && request.resource.data.expected_amount > 0))
        && request.resource.data.recurring is bool
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.category_id))
        && get(/databases/$(database)/documents/categories/$(request.resource.data.category_id)).data.household_id == resource.data.household_id;
    }

    // Mark-paid transition -- the rules-level backstop for idempotency. The
    // diff is limited to exactly status+paid_expense_id, and resource.data.status
    // must still be 'pending' -- a second mark-paid attempt has a stored status
    // of 'paid' already, so this independently rejects it even if application
    // logic were ever bypassed. existsAfter/getAfter (evaluated once every
    // write in the same commit has landed) confirm paid_expense_id actually
    // points at an Expense in the same household, so this write can't fake a
    // paid status against a missing or cross-household Expense id -- it does
    // not, and cannot, verify the Expense's amount/category/member match.
    function isValidCuentaMarkPaid() {
      return resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paid_expense_id'])
        && request.resource.data.status == 'paid'
        && resource.data.paid_expense_id == null
        && request.resource.data.paid_expense_id is string
        && request.resource.data.paid_expense_id.size() > 0
        && existsAfter(/databases/$(database)/documents/expenses/$(request.resource.data.paid_expense_id))
        && getAfter(/databases/$(database)/documents/expenses/$(request.resource.data.paid_expense_id)).data.household_id == resource.data.household_id;
    }

    match /households/{householdId} {
      allow read: if isMemberOf(householdId);
      // Create must land in the same batch as the caller's membership row so
      // undeletable orphan households cannot be written without joining.
      allow create: if isSignedIn()
        && !exists(membershipPath())
        && existsAfter(membershipPath())
        && getAfter(membershipPath()).data.household_id == householdId
        && isValidHousehold(request.resource.data);
      allow update: if isMemberOf(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monthly_budget', 'name'])
        && request.resource.data.monthly_budget is number
        && request.resource.data.monthly_budget > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.matches('.*\\S.*');
      allow delete: if false;
    }

    match /household_members/{userId} {
      // Own uid is readable without exists() so createHouseholdAndMembership
      // can tx.get a missing membership doc. Missing docs have no resource.
      allow read: if isSignedIn() && (
        userId == request.auth.uid
        || isMemberOf(resource.data.household_id)
      );
      // Founder path: household is created in this same batch.
      // Invite-join path: household already exists and invite_token is valid.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (
          (
            !exists(/databases/$(database)/documents/households/$(request.resource.data.household_id))
            && isValidMembership(request.resource.data)
          )
          || (
            !exists(membershipPath())
            && exists(/databases/$(database)/documents/households/$(request.resource.data.household_id))
            && isValidJoinMembership(request.resource.data)
          )
        );
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /household_invites/{token} {
      // Token is the capability: any signed-in user can get a known token.
      // List stays members-only so invites cannot be enumerated.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isMemberOf(resource.data.household_id);
      allow create: if isSignedIn()
        && isValidInvite(request.resource.data)
        && isMemberOf(request.resource.data.household_id);
      allow update, delete: if false;
    }

    match /categories/{categoryId} {
      // Missing docs have no resource; find-or-create must get a missing id
      // before create. Existing docs stay members-only. These are separate
      // allow lines because rules do not short-circuit `||` — reading
      // `resource.data` when resource is null denies the whole expression.
      allow get: if isSignedIn()
        && resource == null
        && isOwnHouseholdCategoryId(categoryId);
      allow get: if isSignedIn()
        && resource != null
        && isMemberOf(resource.data.household_id);
      allow list: if isMemberOf(resource.data.household_id);
      allow create: if isValidCategory(request.resource.data)
        && canWriteCategoryFor(request.resource.data.household_id);
      allow update, delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isMemberOf(resource.data.household_id);
      allow create: if isMemberOf(request.resource.data.household_id)
        && request.resource.data.member_id == request.auth.uid
        && isValidExpense(request.resource.data);
      allow update: if isMemberOf(resource.data.household_id)
        && isValidExpenseUpdate();
      allow delete: if isMemberOf(resource.data.household_id);
    }

    match /cuentas/{cuentaId} {
      allow read: if isMemberOf(resource.data.household_id);
      allow create: if isMemberOf(request.resource.data.household_id)
        && isValidCuenta(request.resource.data);
      allow update: if isMemberOf(resource.data.household_id)
        && (isValidCuentaUpdate() || isValidCuentaMarkPaid());
      allow delete: if isMemberOf(resource.data.household_id)
        && resource.data.status == 'pending';
    }
  }
}
